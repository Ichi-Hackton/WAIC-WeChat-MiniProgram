.guide-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F3EE;
}

.chat {
  flex: 1;
  min-height: 0;
  padding-top: 12rpx;
}

.typing {
  padding: 10rpx 44rpx 16rpx;
  color: #8A8378;
  font-size: 24rpx;
}

.chat-pad {
  height: 32rpx;
}

/* ---------- 底部：提問區 ---------- */
.input-area {
  background: #FFFFFF;
  border-top: 2rpx solid #EFEAE1;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-row {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 24rpx;
}

.chat-input {
  flex: 1;
  background: #F6F3EE;
  border-radius: 999rpx;
  padding: 14rpx 30rpx;
  font-size: 30rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.send-btn {
  margin-left: 16rpx;
  background: #4C6A5A;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 2.6;
}

.send-btn::after {
  border: none;
}

/* ---------- 底部：彙總面板 ---------- */
.summary-panel {
  background: #FFFFFF;
  border-top: 2rpx solid #EFEAE1;
  padding: 28rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

.summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #33302B;
}

.summary-text {
  white-space: pre-line;
  background: #F6F3EE;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: #4A463F;
  line-height: 1.8;
}

.gen-btn {
  margin: 0;
}

.restart {
  text-align: center;
  color: #8A8378;
  font-size: 26rpx;
  padding: 22rpx 0 4rpx;
}
