<view class="page">
  <!-- ═══ 一鍵帶入微信地址（暖色描邊次操作，置於表單之上）═══ -->
  <view class="import-btn" hover-class="btn-hover" bindtap="onTapImportAddress">一鍵帶入微信地址</view>

  <!-- ═══ 帶入未保存提示（常駐，防誤解為已保存直接返回丟失）═══ -->
  <view wx:if="{{imported}}" class="import-hint">
    已帶入微信地址，內容尚未保存——請檢查後點擊下方「{{editing ? '保存修改' : '新增地址'}}」完成保存。
  </view>

  <!-- ═══ 地址表單卡（白卡 + hairline 分隔，與乘車人表單同族）═══ -->
  <view class="form-card">

    <!-- 收貨人 -->
    <view class="field-row">
      <text class="field-label">收貨人</text>
      <input
        class="field-input"
        value="{{receiverName}}"
        bindinput="onNameInput"
        placeholder="與證件一致的姓名"
        placeholder-class="field-placeholder"
        maxlength="20"
      />
    </view>

    <!-- 手機號碼 -->
    <view class="field-row">
      <text class="field-label">手機號碼</text>
      <input
        class="field-input"
        value="{{phone}}"
        bindinput="onPhoneInput"
        type="number"
        placeholder="11 位手機號"
        placeholder-class="field-placeholder"
        maxlength="11"
      />
    </view>

    <!-- 所在地區（省 / 市 / 區三段 picker） -->
    <view class="field-row">
      <text class="field-label">所在地區</text>
      <picker
        mode="region"
        value="{{region}}"
        bindchange="onRegionChange"
      >
        <view class="region-value {{region[0] ? '' : 'field-placeholder'}}">
          {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '選擇省 / 市 / 區'}}
        </view>
      </picker>
    </view>

    <!-- 詳細地址 -->
    <view class="field-row field-row-textarea">
      <text class="field-label">詳細地址</text>
      <textarea
        class="field-textarea"
        value="{{detail}}"
        bindinput="onDetailInput"
        placeholder="街道 / 樓棟 / 門牌號"
        placeholder-class="field-placeholder"
        maxlength="120"
        auto-height
      />
    </view>

    <!-- 設為默認地址 -->
    <view class="field-row field-row-switch">
      <view class="switch-copy">
        <text class="field-label">設為默認地址</text>
        <text class="switch-hint">出行規劃自動帶入出發城市</text>
      </view>
      <switch checked="{{isDefault}}" bindchange="onDefaultChange" color="#8B7355" />
    </view>
  </view>

  <!-- ═══ 保存（深褐實底，唯一主操作）═══ -->
  <view class="save-btn" hover-class="btn-hover" bindtap="onTapSave">{{editing ? '保存修改' : '新增地址'}}</view>

  <!-- ═══ 刪除（僅編輯態；弱化紅字，破壞性操作前有 modal 確認）═══ -->
  <view wx:if="{{editing}}" class="remove-btn" hover-class="btn-hover" bindtap="onTapRemove">刪除此地址</view>
</view>
