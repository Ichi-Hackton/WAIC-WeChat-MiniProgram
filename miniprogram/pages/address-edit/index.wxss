/* ============================================================
   新增 / 編輯收貨地址 —— 侘寂極簡 Wabi-Sabi Restraint

   視覺系統與乘車人編輯頁同族（.qoder/rules/Agent.md 視覺語言）：
   - 米白紙感基底 + 深褐文字 + 暖金克制強調
   - 襯線字標 / 標籤 + 1px hairline 暖灰分隔 + 極小圓角
   - 極慢緩動 cubic-bezier(0.25, 0.1, 0.25, 1)
   ============================================================ */

/* ---------- 基礎 ---------- */

page {
  background: #F5F1E8;
}

.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #2B2018;
  background: #F5F1E8;
}

/* ============================================================
   一鍵帶入微信地址（暖色描邊次操作，置於表單之上）
   ============================================================ */

.import-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #C9B48E;
  border-radius: 8rpx;
  color: #8B7355;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  margin-bottom: 28rpx;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  transition: opacity 0.25s ease;
}

/* ---------- 帶入未保存提示條（暖色左線 + 淡金底，常駐至保存） ---------- */

.import-hint {
  margin: -12rpx 0 24rpx;
  padding: 14rpx 20rpx;
  border-left: 3rpx solid #C9B48E;
  background: rgba(201, 180, 142, 0.12);
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #8B7355;
  letter-spacing: 1rpx;
  line-height: 1.6;
  animation: riseIn 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ============================================================
   表單卡（白卡＋hairline 暖灰邊）
   ============================================================ */

.form-card {
  background: #FCFAF5;
  border: 1rpx solid #E8E0D0;
  border-radius: 8rpx;
  padding: 4rpx 36rpx;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) 0.05s backwards;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- 欄位行（hairline 分隔） ---------- */

.field-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #E8E0D0;
}

/* 標籤：襯線小字暖褐 */
.field-label {
  flex-shrink: 0;
  width: 160rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  font-weight: 500;
  color: #6B5D4A;
  letter-spacing: 2rpx;
}

/* 輸入值：右對齊，聚焦時不另加修飾（最小打擾） */
.field-input {
  flex: 1;
  height: 72rpx;
  text-align: right;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #2B2018;
  letter-spacing: 1rpx;
}

.field-placeholder {
  color: #B3A78F;
  font-weight: 300;
}

/* ---------- 地區 picker 行 ---------- */

.region-value {
  flex: 1;
  text-align: right;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #2B2018;
  letter-spacing: 1rpx;
}

/* ---------- 詳細地址（textarea 行，頂對齊） ---------- */

.field-row-textarea {
  align-items: flex-start;
  padding: 28rpx 0;
}

.field-row-textarea .field-label {
  padding-top: 8rpx;
}

.field-textarea {
  flex: 1;
  min-height: 96rpx;
  text-align: right;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #2B2018;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

/* ---------- 默認地址開關行（末行無分隔線） ---------- */

.field-row-switch {
  justify-content: space-between;
  border-bottom: none;
  padding: 10rpx 0;
}

.switch-copy {
  display: flex;
  flex-direction: column;
}

.switch-copy .field-label {
  width: auto;
}

/* 副提示：小一號的弱化說明 */
.switch-hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 300;
  color: #9A8B72;
  letter-spacing: 1rpx;
}

/* ============================================================
   保存按鈕（深褐實底 + 襯線大字距，唯一主操作）
   ============================================================ */

.save-btn {
  margin-top: 56rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2B2018;
  color: #F5F1E8;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  border-radius: 8rpx;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) 0.08s backwards;
  transition: opacity 0.25s ease;
}

/* ---------- 刪除按鈕（僅編輯態；弱化紅字次操作） ---------- */

.remove-btn {
  margin-top: 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E3C9C1;
  border-radius: 8rpx;
  color: #A4574A;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) 0.12s backwards;
  transition: opacity 0.25s ease;
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.85;
}
