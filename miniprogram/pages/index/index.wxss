.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
}

/* 頂部品牌列 */
.header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.2);
}

.brand {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  flex: 1;
  margin-left: 16rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.reset-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
}

/* 狀態列 */
.status-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e7eb;
  font-size: 22rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-busy {
  background: #6366f1;
  animation: pulse 1.2s ease-in-out infinite;
}

.dot-ok {
  background: #059669;
}

.dot-failed {
  background: #dc2626;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.status-label {
  color: #6b7280;
  margin-right: 8rpx;
}

.status-value {
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-family: monospace;
}

.state-busy {
  color: #6366f1;
  background: #eef2ff;
}

.state-ok {
  color: #059669;
  background: #d1fae5;
}

.state-failed {
  color: #dc2626;
  background: #fee2e2;
}

/* 對話區 */
.chat {
  flex: 1;
  padding: 24rpx 24rpx;
  overflow-y: auto;
}

.bubble {
  margin-bottom: 24rpx;
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.bubble-user {
  margin-left: auto;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}

.bubble-assistant {
  margin-right: auto;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5e7eb;
  border-bottom-left-radius: 4rpx;
}

.bubble-role {
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  opacity: 0.7;
}

.bubble-content {
  white-space: pre-wrap;
}

/* 卡片 */
.cards {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(99, 102, 241, 0.08);
  border-left: 4rpx solid #6366f1;
}

.card-plan {
  border-left-color: #6366f1;
}

.card-result {
  border-left-color: #059669;
  background: rgba(5, 150, 105, 0.08);
}

.card-error {
  border-left-color: #dc2626;
  background: rgba(220, 38, 38, 0.08);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  flex: 1;
  font-size: 24rpx;
  color: #4338ca;
}

.card-skill {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #6b7280;
  font-family: monospace;
}

.card-error-text {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #dc2626;
}

/* 任務進度徽章（隨 onTaskUpdate 即時變色） */
.task-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.task-pending {
  color: #6b7280;
  background: #f3f4f6;
}

.task-running {
  color: #6366f1;
  background: #eef2ff;
}

.task-waiting_human {
  color: #b45309;
  background: #fef3c7;
}

.task-succeeded {
  color: #059669;
  background: #d1fae5;
}

.task-failed {
  color: #dc2626;
  background: #fee2e2;
}

.task-skipped,
.task-rolled_back {
  color: #9ca3af;
  background: #f3f4f6;
}

/* loading 氣泡：階段文案 + 三點彈跳動畫 */
.loading-line {
  display: flex;
  align-items: center;
}

.dots {
  display: inline-flex;
  align-items: flex-end;
  margin-left: 10rpx;
  height: 24rpx;
}

.dots .dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: #6366f1;
  animation: bounce 1.2s ease-in-out infinite;
}

.dots .dot:nth-child(2) {
  animation-delay: 0.15s;
}

.dots .dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10rpx);
  }
}

/* 範例 */
.examples {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
}

.examples-title {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.example-chip {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 10rpx 20rpx;
  background: #eef2ff;
  color: #4338ca;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 輸入列 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.mic-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
  margin-right: 12rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 12rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #e5e7eb;
  color: #9ca3af;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn-active {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
}

.send-btn-disabled {
  opacity: 0.5;
}