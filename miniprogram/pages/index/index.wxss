/* ============================================================
   MicroMate 首頁視覺系統 v4 —— 侘寂極簡 Wabi-Sabi Restraint

   設計語言：借鑒 SK-II 日式極簡美學
   - 米白紙感基底 + 深褐文字 + 暖金克制強調
   - 襯線字標（Songti SC / Source Han Serif）+ 無襯線正文
   - 1px hairline 暖灰邊線 + 極小圓角 + 幾乎無陰影
   - 極慢緩動 cubic-bezier(0.25, 0.1, 0.25, 1) + 純淡入
   - 去 emoji + 去 teal 漸變 + 去橙金強調
   ============================================================ */

/* ---------- 基礎 ---------- */

page {
  background: #F5F1E8;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #2B2018;
  background: #F5F1E8;
}

/* ============================================================
   啟動載入畫面（splash）：米白底＋襯線字標＋水平細線展開
   ============================================================ */

.splash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F1E8;
  transition: opacity 0.8s ease;
}

.splash-fade {
  opacity: 0;
  pointer-events: none;
}

.splash-inner {
  display: flex;
  align-items: center;
}

/* 啟動畫面品牌圖示：圓形裁切（與聊天頭像同一家族，視覺一致） */
.splash-mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  background: #EFE9DD;
  flex-shrink: 0;
}

.splash-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.splash-name {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 42rpx;
  font-weight: 400;
  color: #2B2018;
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.splash-tagline {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6B5D4A;
  letter-spacing: 4rpx;
  font-weight: 300;
}

/* 底部水平細線：從中心向兩端展開（0.6s，與首次冷啟動 800ms 展示窗口對齊） */
.splash-line {
  margin-top: 80rpx;
  width: 240rpx;
  height: 1rpx;
  background: #8B7355;
  transform-origin: center;
  animation: lineExpand 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) backwards;
}

@keyframes lineExpand {
  from { transform: scaleX(0); opacity: 0; }
  to { transform: scaleX(1); opacity: 1; }
}

/* ============================================================
   頂部狀態條（純文字標籤＋極簡重置）
   ============================================================ */

.status-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx 16rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  padding: 0;
  background: transparent;
}

.pill-busy { color: #8B7355; }
.pill-ok { color: #5A7A4E; }
.pill-failed { color: #A04A3C; }
.pill-idle { color: #9A8B72; }

.status-dot {
  font-size: 22rpx;
  margin-right: 8rpx;
  font-weight: 700;
  line-height: 1;
}

.dot-busy { color: #8B7355; animation: breathe 2.4s ease-in-out infinite; }
.dot-ok { color: #5A7A4E; }
.dot-failed { color: #A04A3C; }
.dot-idle { color: #9A8B72; }

@keyframes breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* LLM 狀態列已移除（模型對用戶不可見，由雲端固定）：「我的」按鈕以
   auto 邊距接管彈性佔位，維持「狀態膠囊居左、操作按鈕居右」佈局 */
.profile-btn {
  margin-left: auto;
}

.reset-btn,
.profile-btn {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  color: #6B5D4A;
  letter-spacing: 2rpx;
  background: transparent;
  border: none;
  transition: opacity 0.25s ease;
}

.reset-btn:active,
.profile-btn:active {
  opacity: 0.5;
}

/* ============================================================
   對話區
   ============================================================ */

.chat {
  flex: 1;
  height: 0;
  padding: 8rpx 40rpx 16rpx;
  box-sizing: border-box;
}

.msg-user,
.msg-ai {
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 用戶訊息：右對齊文字 + 暖金左側細線引述塊 */
.msg-user {
  display: flex;
  justify-content: flex-end;
  margin: 24rpx 0 32rpx;
}

.user-bubble {
  max-width: 76%;
  padding: 14rpx 0 14rpx 24rpx;
  border-left: 4rpx solid #8B7355;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.7;
  word-break: break-word;
  color: #2B2018;
  background: transparent;
}

/* AI 訊息 */
.msg-ai {
  display: flex;
  margin: 24rpx 0 36rpx;
}

.ai-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EFE9DD;
  margin-right: 24rpx;
  position: relative;
  overflow: hidden;
}

/* 頭像圖片填滿圓形容器（aspectFill 裁切，保留主體佔據中央） */
.ai-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* loading 時：底部 1px 暖金細線緩慢循環位移 */
.is-loading .ai-avatar::after {
  content: '';
  position: absolute;
  left: 8rpx;
  bottom: 6rpx;
  width: 48rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #8B7355, transparent);
  animation: lineSlide 2s linear infinite;
}

@keyframes lineSlide {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

.ai-body {
  flex: 1;
  min-width: 0;
}

.ai-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ai-name {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  font-weight: 500;
  color: #6B5D4A;
  margin-right: 14rpx;
  letter-spacing: 2rpx;
}

.ai-tag {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 18rpx;
  font-weight: 300;
  color: #9A8B72;
  letter-spacing: 1rpx;
}

.ai-content {
  font-size: 28rpx;
  line-height: 1.75;
  color: #2B2018;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ============================================================
   卡片容器
   ============================================================ */

.cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ============================================================
   交付卡基底（白卡＋hairline 暖灰邊＋極小圓角）
   ============================================================ */

.card-delivery {
  background: #FCFAF5;
  border: 1rpx solid #E8E0D0;
  border-radius: 8rpx;
  padding: 32rpx 36rpx;
  overflow: hidden;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.delivery-title {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2018;
  letter-spacing: 2rpx;
}

.order-head {
  display: flex;
  align-items: baseline;
}

.order-mark {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #8B7355;
  margin-right: 12rpx;
  line-height: 1;
}

/* ============================================================
   車次交付卡
   ============================================================ */

.route-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.route {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.route-city {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 36rpx;
  font-weight: 500;
  color: #2B2018;
  letter-spacing: 4rpx;
}

.route-mid {
  display: flex;
  align-items: center;
  margin: 0 18rpx;
  flex: 0 0 auto;
}

.route-line {
  width: 32rpx;
  height: 1rpx;
  background: #C9BDA1;
}

.route-ico {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  margin: 0 8rpx;
  font-size: 22rpx;
  color: #6B5D4A;
}

/* 數據源標籤：純文字標籤 */
.source-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.source-real { color: #5A7A4E; }
.source-mock { color: #9A8B72; }

.route-sub {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9A8B72;
  font-weight: 300;
  letter-spacing: 1rpx;
}

.train-list {
  margin-top: 16rpx;
}

.train-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #E8E0D0;
}

.train-row:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.train-soldout {
  opacity: 0.4;
}

.train-info {
  min-width: 0;
}

.train-top {
  display: flex;
  align-items: baseline;
}

.train-no {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2018;
  letter-spacing: 2rpx;
}

.train-duration {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #9A8B72;
  font-weight: 300;
}

.train-time {
  margin-top: 8rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  color: #2B2018;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.train-remain {
  display: inline-block;
  margin-top: 10rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 20rpx;
  color: #5A7A4E;
  letter-spacing: 1rpx;
}

.remain-out {
  color: #9A8B72;
}

.train-act {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.train-price {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 32rpx;
  font-weight: 500;
  color: #6B4E2A;
  letter-spacing: 1rpx;
}

/* 快捷預訂 CTA：襯線文字 + 暖金色 + 尾部箭頭，hover 加深 */
.book-btn {
  margin-top: 14rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #8B7355;
  letter-spacing: 2rpx;
  background: transparent;
  border: none;
  padding: 4rpx 0;
  transition: opacity 0.25s ease, color 0.25s ease;
}

.book-btn::after {
  content: ' ▸';
}

.book-btn-off {
  color: #9A8B72;
}

.book-btn-off::after {
  content: '';
}

/* ============================================================
   訂單交付卡（hairline 憑證區）
   ============================================================ */

.order-body {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E8E0D0;
}

.order-line {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}

.order-label {
  flex-shrink: 0;
  width: 140rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  color: #9A8B72;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.order-value {
  flex: 1;
  font-size: 24rpx;
  color: #2B2018;
  word-break: break-all;
}

.order-highlight {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  color: #6B4E2A;
  font-weight: 500;
  font-size: 40rpx;
  letter-spacing: 1rpx;
}

/* 快捷支付入口（待支付訂單卡尾部 CTA，與 book-btn 同語言的描邊按鈕形態） */
.order-act {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E8E0D0;
  display: flex;
  justify-content: flex-end;
}

.pay-btn {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #8B7355;
  letter-spacing: 2rpx;
  background: transparent;
  border: 1rpx solid #C9B896;
  border-radius: 6rpx;
  padding: 10rpx 28rpx;
  transition: opacity 0.25s ease;
}

/* ============================================================
   跳轉下單交付卡（2026-10 跳轉模式：複製資訊 / 前往下單，
   真實交易在 12306 / 京東 / 美團 / OTA 等官方渠道側完成）
   ============================================================ */

/* 渠道說明行（「真實交易於外部官方渠道完成…」的淺色提示） */
.jump-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #A39277;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

/* 複製資訊按鈕（與 pay-btn 同語言的描邊形態，右側留間距與主跳轉鈕並排） */
.copy-btn {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #8B7355;
  letter-spacing: 2rpx;
  background: transparent;
  border: 1rpx solid #C9B896;
  border-radius: 6rpx;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  transition: opacity 0.25s ease;
}

/* ============================================================
   天氣交付卡（實況：城市 + 現象 + 大字溫度；明細行復用 order-line）
   ============================================================ */

.weather-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.weather-main {
  display: flex;
  align-items: baseline;
}

.weather-city {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2018;
  letter-spacing: 2rpx;
}

.weather-condition {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9A8B72;
  letter-spacing: 2rpx;
}

.weather-temp {
  margin: 12rpx 0 4rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 96rpx;
  font-weight: 600;
  color: #2B2018;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

/* ============================================================
   通用交付卡副標題（generic 卡右上角 skillId.action 標籤）
   ============================================================ */

.product-kw {
  margin-left: auto;
  flex-shrink: 0;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 20rpx;
  color: #9A8B72;
  font-weight: 300;
  letter-spacing: 1rpx;
}

/* ============================================================
   計劃步驟卡
   ============================================================ */

.plan-card {
  background: #FCFAF5;
  border: 1rpx solid #E8E0D0;
  border-radius: 8rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.step-no {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #C9BDA1;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 20rpx;
  color: #6B5D4A;
}

.step-running {
  color: #8B7355;
  border-color: #8B7355;
}

.step-waiting_human {
  color: #8A7048;
  border-color: #8A7048;
}

.step-succeeded {
  color: #5A7A4E;
  border-color: #5A7A4E;
}

.step-failed {
  color: #A04A3C;
  border-color: #A04A3C;
}

.step-body {
  flex: 1;
  min-width: 0;
}

/* 標題行：任務名 + 時間線標籤（行程 DAG）水平並排 */
.step-title-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.step-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  font-weight: 500;
  color: #2B2018;
  letter-spacing: 1rpx;
}

/* 時間線標籤（行程 DAG 任務攜帶，如「10/11 下周六」；與狀態徽章同風格的暖金小字） */
.step-time {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #8B7355;
}

.step-error {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #A04A3C;
}

/* 任務狀態徽章：純文字標籤，無背景色塊 */
.task-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  background: transparent;
}

.task-pending { color: #9A8B72; }
.task-running { color: #8B7355; }
.task-waiting_human { color: #8A7048; }
.task-succeeded { color: #5A7A4E; }
.task-failed { color: #A04A3C; }
.task-skipped, .task-rolled_back { color: #9A8B72; }

/* ============================================================
   Loading 氣泡
   ============================================================ */

.loading-line {
  display: flex;
  align-items: center;
  color: #6B5D4A;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.dots {
  display: inline-flex;
  align-items: flex-end;
  margin-left: 12rpx;
  height: 26rpx;
}

/* 打字點改為暖金細線段（去圓點） */
.dots .dot {
  width: 16rpx;
  height: 1rpx;
  margin-right: 8rpx;
  border-radius: 0;
  background: #8B7355;
  animation: lineSlide 2s linear infinite;
}

.dots .dot:nth-child(2) {
  animation-delay: 0.3s;
}

.dots .dot:nth-child(3) {
  animation-delay: 0.6s;
}

/* ============================================================
   場景範例（細描邊方框 + 襯線暖灰字）
   ============================================================ */

.examples {
  padding: 20rpx 40rpx 8rpx;
}

.examples-title {
  display: block;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 22rpx;
  color: #9A8B72;
  font-weight: 400;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.example-chip {
  display: inline-flex;
  align-items: center;
  margin: 0 12rpx 14rpx 0;
  padding: 12rpx 24rpx;
  background: transparent;
  border: 1rpx solid #C9BDA1;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #6B5D4A;
  letter-spacing: 1rpx;
  border-radius: 4rpx;
  animation: riseIn 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) backwards;
  transition: border-color 0.25s ease, color 0.25s ease;
}

.example-chip:nth-child(2) { animation-delay: 0.08s; }
.example-chip:nth-child(3) { animation-delay: 0.16s; }
.example-chip:nth-child(4) { animation-delay: 0.24s; }
.example-chip:nth-child(5) { animation-delay: 0.32s; }

.example-chip:active {
  border-color: #8B7355;
  color: #8B7355;
}

.btn-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

/* ============================================================
   輸入區（底部 hairline + 麥克風細描邊圓鈕 + 居中輸入框 + 細描邊圓鈕）
   ============================================================ */

.input-bar {
  padding: 16rpx 40rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.input-shell {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  background: transparent;
  border: none;
  border-top: 1rpx solid #C9BDA1;
  border-radius: 0;
}

.input {
  flex: 1;
  height: 72rpx;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #2B2018;
  letter-spacing: 1rpx;
}

.input-ph {
  color: #9A8B72;
  font-style: italic;
  font-weight: 300;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid #C9BDA1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #9A8B72;
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 28rpx;
  font-weight: 500;
  transition: border-color 0.3s ease, color 0.3s ease;
}

.send-btn-active {
  border-color: #8B7355;
  color: #8B7355;
}

.send-btn-disabled {
  opacity: 0.5;
}

/* ============================================================
   語音麥克風（同聲傳譯插件可用時渲染；與 send-btn 同族細描邊圓鈕）
   ============================================================ */

.voice-btn {
  flex-shrink: 0;
  margin-right: 20rpx;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid #C9BDA1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  transition: border-color 0.3s ease;
}

/* 麥克風圖標：膠囊頭 + U 形支臂（偽元素）+ 底座立柱，純 CSS 繪製 */
.mic-icon {
  position: relative;
  width: 12rpx;
  height: 20rpx;
  border: 2rpx solid #9A8B72;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-top: -6rpx;
}

.mic-icon::before {
  /* U 形支臂：包住膠囊頭下部 */
  content: '';
  position: absolute;
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 2rpx solid #9A8B72;
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
  box-sizing: border-box;
}

.mic-icon::after {
  /* 底座立柱 */
  content: '';
  position: absolute;
  left: 50%;
  top: 24rpx;
  transform: translateX(-50%);
  width: 2rpx;
  height: 6rpx;
  background: #9A8B72;
}

/* 錄音中：警示紅調 + 外圈呼吸脈衝（與 dot-busy 呼吸動畫同節奏） */
.voice-btn-on {
  border-color: #A04A3C;
  animation: voice-pulse 2.4s ease-in-out infinite;
}

.mic-icon-on,
.mic-icon-on::before {
  border-color: #A04A3C;
}

.mic-icon-on::after {
  background: #A04A3C;
}

@keyframes voice-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(160, 74, 60, 0.22); }
  50% { box-shadow: 0 0 0 14rpx rgba(160, 74, 60, 0); }
}

/* 錄音中輸入框：識別結果即時上屏（唯讀），色調微暖提示 */
.input-recording {
  color: #A04A3C;
}
