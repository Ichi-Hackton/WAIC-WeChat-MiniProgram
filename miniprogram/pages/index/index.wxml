<view class="page">
  <!-- ═══ 啟動載入畫面：米白底＋襯線字標＋水平細線展開（侘寂極簡）═══ -->
  <view wx:if="{{splash}}" class="splash {{splashFading ? 'splash-fade' : ''}}">
    <view class="splash-inner">
      <text class="splash-mark">{{brandAvatar}}</text>
      <view class="splash-text">
        <text class="splash-name">{{brandName}}</text>
        <text class="splash-tagline">{{splashTagline}}</text>
      </view>
    </view>
    <view class="splash-line"></view>
  </view>

  <!-- ═══ 頂部狀態條（純文字標籤＋極簡重置）═══ -->
  <view class="status-bar">
    <view class="status-pill pill-{{state === 'failed' ? 'failed' : (state === 'completed' ? 'ok' : (state === 'idle' ? 'idle' : 'busy'))}}">
      <text class="status-dot dot-{{state === 'failed' ? 'failed' : (state === 'completed' ? 'ok' : (state === 'idle' ? 'idle' : 'busy'))}}">·</text>
      <text>{{stateLabel}}</text>
    </view>
    <text class="llm-label">{{llmLabel}}</text>
    <view class="reset-btn" hover-class="btn-hover" bindtap="onTapReset">重置</view>
  </view>

  <!-- ═══ 對話區（新訊息自動捲動）═══ -->
  <scroll-view class="chat" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="true">
    <block wx:for="{{messages}}" wx:key="id">

      <!-- 用戶訊息：右對齊文字 + 暖金細線引述塊 -->
      <view wx:if="{{item.role === 'user'}}" class="msg-user" id="{{item.id}}">
        <view class="user-bubble">{{item.content}}</view>
      </view>

      <!-- AI 訊息：頭像 + 平鋪寬內容（不套氣泡，交付卡有完整展示空間） -->
      <view wx:else class="msg-ai" id="{{item.id}}">
        <view class="ai-avatar">{{brandAvatar}}</view>
        <view class="ai-body">
          <!-- 合規：所有 LLM 輸出需掛 AI 生成標識 -->
          <view class="ai-head">
            <text class="ai-name">{{brandName}}</text>
            <view class="ai-tag">AI 生成</view>
          </view>
          <view wx:if="{{item.content}}" class="ai-content">{{item.content}}</view>

          <!-- 結構化交付卡 + 計劃步驟卡 -->
          <view wx:if="{{item.cards && item.cards.length > 0}}" class="cards">
            <block wx:for="{{item.cards}}" wx:for-item="card" wx:key="key">

              <!-- 車次交付卡：大字路線頭 + 左右分欄班次行，每班掛快捷預訂 -->
              <view wx:if="{{card.type === 'train'}}" class="card-delivery">
                <view class="route-head">
                  <view class="route">
                    <text class="route-city">{{card.routeFrom}}</text>
                    <view class="route-mid">
                      <view class="route-line"></view>
                      <text class="route-ico">—</text>
                      <view class="route-line"></view>
                    </view>
                    <text class="route-city">{{card.routeTo}}</text>
                  </view>
                  <view class="source-tag {{card.sourceReal ? 'source-real' : 'source-mock'}}">{{card.sourceLabel}}</view>
                </view>
                <view class="route-sub">
                  <text class="route-date">{{card.routeDate}}</text>
                  <text class="route-more">{{card.moreLabel}}</text>
                </view>
                <view class="train-list">
                  <view wx:for="{{card.trains}}" wx:for-item="t" wx:key="trainNo" class="train-row {{t.soldOut ? 'train-soldout' : ''}}">
                    <view class="train-info">
                      <view class="train-top">
                        <text class="train-no">{{t.trainNo}}</text>
                        <text class="train-duration">{{t.durationLabel}}</text>
                      </view>
                      <view class="train-time">{{t.departTime}} — {{t.arriveTime}}</view>
                      <text class="train-remain {{t.soldOut ? 'remain-out' : ''}}">{{t.remainLabel}}</text>
                    </view>
                    <view class="train-act">
                      <text class="train-price">{{t.priceLabel}}</text>
                      <view wx:if="{{!t.soldOut}}" class="book-btn" hover-class="btn-hover" bindtap="onTapBookTrain" data-train-no="{{t.trainNo}}" data-ctx="{{card.bookCtx}}">預訂</view>
                      <view wx:else class="book-btn book-btn-off">無票</view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 訂單交付卡：襯線標題 + hairline 憑證區 -->
              <view wx:elif="{{card.type === 'order'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                </view>
                <view class="order-body">
                  <view wx:for="{{card.lines}}" wx:for-item="line" wx:key="label" class="order-line">
                    <text class="order-label">{{line.label}}</text>
                    <text class="order-value {{line.highlight ? 'order-highlight' : ''}}">{{line.value}}</text>
                  </view>
                </view>
              </view>

              <!-- 門市交付卡 -->
              <view wx:elif="{{card.type === 'store'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                </view>
                <view class="store-list">
                  <view wx:for="{{card.stores}}" wx:for-item="s" wx:key="name" class="store-row">
                    <view class="store-name">
                      <text>{{s.name}}</text>
                      <view class="store-open {{s.openLabel === '營業中' ? 'open-yes' : 'open-no'}}">{{s.openLabel}}</view>
                    </view>
                    <view class="store-addr">{{s.address}}<text wx:if="{{s.distanceLabel}}" class="store-dist"> · {{s.distanceLabel}}</text></view>
                  </view>
                </view>
              </view>

              <!-- 商品交付卡：左信息右操作，每件掛快捷加購 -->
              <view wx:elif="{{card.type === 'product'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                  <text class="product-kw">{{card.keywordLabel}}</text>
                </view>
                <view class="product-list">
                  <view wx:for="{{card.products}}" wx:for-item="p" wx:key="productId" class="product-row {{p.soldOut ? 'product-soldout' : ''}}">
                    <view class="product-info">
                      <view class="product-top">
                        <text class="product-name">{{p.name}}</text>
                        <text wx:if="{{p.ratingLabel}}" class="product-rating">★ {{p.ratingLabel}}</text>
                      </view>
                      <view class="product-meta">{{p.category}} · {{p.stockLabel}}</view>
                    </view>
                    <view class="train-act">
                      <text class="train-price">{{p.priceLabel}}</text>
                      <view wx:if="{{!p.soldOut}}" class="book-btn" hover-class="btn-hover" bindtap="onTapAddProduct" data-name="{{p.name}}">加購</view>
                      <view wx:else class="book-btn book-btn-off">售罄</view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 預約服務交付卡：時段 chips 瀏覽，每項掛快捷預約（首個可約時段） -->
              <view wx:elif="{{card.type === 'booking'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                  <text class="product-kw">{{card.date}}</text>
                </view>
                <view class="booking-list">
                  <view wx:for="{{card.services}}" wx:for-item="sv" wx:key="serviceId" class="booking-row">
                    <view class="booking-info">
                      <view class="booking-top">
                        <text class="booking-name">{{sv.name}}</text>
                      </view>
                      <view class="booking-meta">{{sv.provider}} · {{sv.durationLabel}}</view>
                      <view class="slot-row">
                        <view wx:for="{{sv.slots}}" wx:for-item="slot" wx:key="startTime" class="slot-chip {{slot.available ? 'slot-open' : 'slot-full'}}">{{slot.startTime}}</view>
                      </view>
                    </view>
                    <view class="train-act">
                      <text class="train-price">{{sv.priceLabel}}</text>
                      <view wx:if="{{sv.anyAvailable}}" class="book-btn" hover-class="btn-hover" bindtap="onTapBookService" data-service-name="{{sv.name}}" data-date="{{card.date}}" data-first-slot="{{sv.firstSlot}}">預約 {{sv.firstSlot}}</view>
                      <view wx:else class="book-btn book-btn-off">已滿約</view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 計劃步驟卡：序號方塊 + 摘要 + 狀態徽章 -->
              <view wx:else class="plan-card">
                <view class="step-no step-{{card.payload.status}}">{{card.payload.seq}}</view>
                <view class="step-body">
                  <view class="step-title">{{card.title}}</view>
                  <text wx:if="{{card.payload.skill}}" class="step-skill">{{card.payload.skill}}</text>
                  <text wx:if="{{card.payload.error}}" class="step-error">{{card.payload.error}}</text>
                </view>
                <text wx:if="{{card.payload.statusLabel}}" class="task-badge task-{{card.payload.status}}">{{card.payload.statusLabel}}</text>
              </view>

            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- loading：AI 頭像（思考中流光）+ 階段文案 + 打字點 -->
    <view wx:if="{{loading}}" class="msg-ai is-loading" id="loading-bubble">
      <view class="ai-avatar">{{brandAvatar}}</view>
      <view class="ai-body">
        <view class="ai-head">
          <text class="ai-name">{{brandName}}</text>
          <view class="ai-tag">AI 生成</view>
        </view>
        <view class="ai-content loading-line">
          <text>{{stateLabel}}</text>
          <view class="dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ═══ 場景範例（僅首輪顯示；splash 結束後錯落入場）═══ -->
  <view wx:if="{{messages.length <= 1 && !splash}}" class="examples">
    <text class="examples-title">我可以幫你辦：</text>
    <view class="example-chip" hover-class="btn-hover" bindtap="onTapExample" data-text="明天北京到上海的高鐵，二等座">查高鐵車次</view>
    <view class="example-chip" hover-class="btn-hover" bindtap="onTapExample" data-text="幫我點一杯拿鐵">點杯咖啡</view>
    <view class="example-chip" hover-class="btn-hover" bindtap="onTapExample" data-text="上海附近的星巴克">找門市</view>
    <view class="example-chip" hover-class="btn-hover" bindtap="onTapExample" data-text="幫我買一副無線降噪耳機">買降噪耳機</view>
    <view class="example-chip" hover-class="btn-hover" bindtap="onTapExample" data-text="預約明天的羽毛球場">約羽毛球場</view>
  </view>

  <!-- ═══ 輸入區：底部 hairline + 居中輸入框 + 細描邊圓鈕（侘寂極簡）═══ -->
  <view class="input-bar">
    <view class="input-shell">
      <input
        class="input"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="onSend"
        placeholder="用一段自然語言描述你的需求……"
        placeholder-class="input-ph"
        confirm-type="send"
      />
      <view class="send-btn {{inputText.length > 0 && !loading ? 'send-btn-active' : ''}} {{loading ? 'send-btn-disabled' : ''}}" hover-class="btn-hover" bindtap="onSend">↑</view>
    </view>
  </view>
</view>
