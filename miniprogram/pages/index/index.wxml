<view class="page">
  <!-- ═══ 啟動載入畫面：米白底＋頭像圖片＋襯線字標＋水平細線展開（侘寂極簡）═══ -->
  <view wx:if="{{splash}}" class="splash {{splashFading ? 'splash-fade' : ''}}">
    <view class="splash-inner">
      <image class="splash-mark" src="{{avatarImg}}" mode="aspectFill"></image>
      <view class="splash-text">
        <text class="splash-name">{{brandName}}</text>
        <text class="splash-tagline">{{splashTagline}}</text>
      </view>
    </view>
    <view class="splash-line"></view>
  </view>

  <!-- ═══ 頂部狀態條（純文字標籤＋極簡重置）═══ -->
  <view class="status-bar">
    <view class="status-pill pill-{{state === 'failed' ? 'failed' : (state === 'completed' ? 'ok' : (state === 'idle' ? 'idle' : 'busy'))}}">
      <text class="status-dot dot-{{state === 'failed' ? 'failed' : (state === 'completed' ? 'ok' : (state === 'idle' ? 'idle' : 'busy'))}}">·</text>
      <text>{{stateLabel}}</text>
    </view>
    <view class="profile-btn" hover-class="btn-hover" bindtap="onTapTrips">行程</view>
    <view class="profile-btn" hover-class="btn-hover" bindtap="onTapProfile">我的</view>
    <view class="reset-btn" hover-class="btn-hover" bindtap="onTapReset">重置</view>
  </view>

  <!-- ═══ 對話區（新訊息自動捲動）═══ -->
  <scroll-view class="chat" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="true">
    <block wx:for="{{messages}}" wx:key="id">

      <!-- 用戶訊息：右對齊文字 + 暖金細線引述塊 -->
      <view wx:if="{{item.role === 'user'}}" class="msg-user" id="{{item.id}}">
        <view class="user-bubble">{{item.content}}</view>
      </view>

      <!-- AI 訊息：頭像圖片 + 平鋪寬內容（不套氣泡，交付卡有完整展示空間） -->
      <view wx:else class="msg-ai" id="{{item.id}}">
        <view class="ai-avatar">
          <image class="ai-avatar-img" src="{{avatarImg}}" mode="aspectFill"></image>
        </view>
        <view class="ai-body">
          <!-- 合規：所有 LLM 輸出需掛 AI 生成標識 -->
          <view class="ai-head">
            <text class="ai-name">{{brandName}}</text>
            <view class="ai-tag">AI 生成</view>
          </view>
          <view wx:if="{{item.content}}" class="ai-content">{{item.content}}</view>

          <!-- 結構化交付卡 + 計劃步驟卡 -->
          <view wx:if="{{item.cards && item.cards.length > 0}}" class="cards">
            <block wx:for="{{item.cards}}" wx:for-item="card" wx:key="key">

              <!-- 車次交付卡：大字路線頭 + 左右分欄班次行，每班掛快捷預訂 -->
              <view wx:if="{{card.type === 'train'}}" class="card-delivery">
                <view class="route-head">
                  <view class="route">
                    <text class="route-city">{{card.routeFrom}}</text>
                    <view class="route-mid">
                      <view class="route-line"></view>
                      <text class="route-ico">—</text>
                      <view class="route-line"></view>
                    </view>
                    <text class="route-city">{{card.routeTo}}</text>
                  </view>
                  <view class="source-tag {{card.sourceReal ? 'source-real' : 'source-mock'}}">{{card.sourceLabel}}</view>
                </view>
                <view class="route-sub">
                  <text class="route-date">{{card.routeDate}}</text>
                  <text class="route-more">{{card.moreLabel}}</text>
                </view>
                <view class="train-list">
                  <view wx:for="{{card.trains}}" wx:for-item="t" wx:key="trainNo" class="train-row {{t.soldOut ? 'train-soldout' : ''}}">
                    <view class="train-info">
                      <view class="train-top">
                        <text class="train-no">{{t.trainNo}}</text>
                        <text class="train-duration">{{t.durationLabel}}</text>
                      </view>
                      <view class="train-time">{{t.departTime}} — {{t.arriveTime}}</view>
                      <text class="train-remain {{t.soldOut ? 'remain-out' : ''}}">{{t.remainLabel}}</text>
                    </view>
                    <view class="train-act">
                      <text class="train-price">{{t.priceLabel}}</text>
                      <view wx:if="{{!t.soldOut}}" class="book-btn" hover-class="btn-hover" bindtap="onTapBookTrain" data-train-no="{{t.trainNo}}" data-ctx="{{card.bookCtx}}">預訂</view>
                      <view wx:else class="book-btn book-btn-off">無票</view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 航班交付卡：大字路線頭 + 航司 / 機場航站樓明細行，每班掛快捷預訂 -->
              <view wx:elif="{{card.type === 'flight'}}" class="card-delivery">
                <view class="route-head">
                  <view class="route">
                    <text class="route-city">{{card.routeFrom}}</text>
                    <view class="route-mid">
                      <view class="route-line"></view>
                      <text class="route-ico">✈</text>
                      <view class="route-line"></view>
                    </view>
                    <text class="route-city">{{card.routeTo}}</text>
                  </view>
                  <view class="source-tag {{card.sourceReal ? 'source-real' : 'source-mock'}}">{{card.sourceLabel}}</view>
                </view>
                <view class="route-sub">
                  <text class="route-date">{{card.routeDate}}</text>
                  <text class="route-more">{{card.moreLabel}}</text>
                </view>
                <view class="train-list">
                  <view wx:for="{{card.flights}}" wx:for-item="f" wx:key="flightNo" class="train-row">
                    <view class="train-info">
                      <view class="train-top">
                        <text class="train-no">{{f.flightNo}}</text>
                        <text class="train-duration">{{f.durationLabel}}</text>
                      </view>
                      <view class="train-time">{{f.departTime}} — {{f.arriveTime}}</view>
                      <text class="train-remain">{{f.airline}} · {{f.fromAirport}} → {{f.toAirport}}</text>
                    </view>
                    <view class="train-act">
                      <text class="train-price">{{f.priceLabel}}</text>
                      <view class="book-btn" hover-class="btn-hover" bindtap="onTapBookFlight" data-flight-no="{{f.flightNo}}" data-ctx="{{card.bookCtx}}">預訂</view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 跳轉下單交付卡：憑證要素 + 複製資訊 / 前往下單（真實交易在官方渠道側完成） -->
              <view wx:elif="{{card.type === 'jump'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                </view>
                <view class="order-body">
                  <view wx:for="{{card.lines}}" wx:for-item="line" wx:key="label" class="order-line">
                    <text class="order-label">{{line.label}}</text>
                    <text class="order-value {{line.highlight ? 'order-highlight' : ''}}">{{line.value}}</text>
                  </view>
                </view>
                <view class="jump-note">{{card.note}}</view>
                <view class="order-act">
                  <view class="copy-btn" hover-class="btn-hover" bindtap="onTapCopyJumpInfo" data-text="{{card.copyText}}">複製資訊</view>
                  <view wx:if="{{card.jumpBtn}}" class="pay-btn" hover-class="btn-hover" bindtap="onTapJumpMini" data-appid="{{card.jumpBtn.appId}}" data-path="{{card.jumpBtn.path}}">{{card.jumpBtn.label}}</view>
                </view>
              </view>

              <!-- 天氣交付卡：城市 + 現象 + 大字溫度，濕度 / 風力 / 發布時間明細行 -->
              <view wx:elif="{{card.type === 'weather'}}" class="card-delivery">
                <view class="weather-head">
                  <view class="weather-main">
                    <text class="weather-city">{{card.city}}</text>
                    <text class="weather-condition">{{card.condition}}</text>
                  </view>
                  <view class="source-tag {{card.sourceReal ? 'source-real' : 'source-mock'}}">{{card.sourceLabel}}</view>
                </view>
                <view class="weather-temp">{{card.tempLabel}}</view>
                <view class="order-body">
                  <view wx:for="{{card.lines}}" wx:for-item="line" wx:key="label" class="order-line">
                    <text class="order-label">{{line.label}}</text>
                    <text class="order-value">{{line.value}}</text>
                  </view>
                </view>
              </view>

              <!-- 通用兜底交付卡：未知 action 的成功結果（interaction/card-render 渲染） -->
              <view wx:elif="{{card.type === 'generic'}}" class="card-delivery">
                <view class="order-head">
                  <text class="order-mark">·</text>
                  <text class="delivery-title">{{card.title}}</text>
                  <text wx:if="{{card.subtitle}}" class="product-kw">{{card.subtitle}}</text>
                </view>
                <view class="order-body">
                  <view wx:for="{{card.lines}}" wx:for-item="line" wx:key="label" class="order-line">
                    <text class="order-label">{{line.label}}</text>
                    <text class="order-value">{{line.value}}</text>
                  </view>
                </view>
              </view>

              <!-- 計劃步驟卡：序號方塊 + 時間標籤 + 中文摘要 + 狀態徽章（不展示 skillId 等技術標識） -->
              <view wx:else class="plan-card">
                <view class="step-no step-{{card.payload.status}}">{{card.payload.seq}}</view>
                <view class="step-body">
                  <view class="step-title-row">
                    <text class="step-title">{{card.title}}</text>
                    <!-- 時間線標籤（行程 DAG 任務攜帶，如「10/11 下周六」） -->
                    <text wx:if="{{card.payload.timeLabel}}" class="step-time">{{card.payload.timeLabel}}</text>
                  </view>
                  <text wx:if="{{card.payload.error}}" class="step-error">{{card.payload.error}}</text>
                </view>
                <text wx:if="{{card.payload.statusLabel}}" class="task-badge task-{{card.payload.status}}">{{card.payload.statusLabel}}</text>
              </view>

            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- loading：AI 頭像圖片（思考中流光）+ 階段文案 + 打字點 -->
    <view wx:if="{{loading}}" class="msg-ai is-loading" id="loading-bubble">
      <view class="ai-avatar">
        <image class="ai-avatar-img" src="{{avatarImg}}" mode="aspectFill"></image>
      </view>
      <view class="ai-body">
        <view class="ai-head">
          <text class="ai-name">{{brandName}}</text>
          <view class="ai-tag">AI 生成</view>
        </view>
        <view class="ai-content loading-line">
          <text>{{stateLabel}}</text>
          <view class="dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ═══ 快捷入口（僅首輪顯示；常用話語個人化，無記錄時回退出廠範例；splash 結束後錯落入場）═══ -->
  <view wx:if="{{messages.length <= 1 && !splash}}" class="examples">
    <text class="examples-title">{{chipsTitle}}</text>
    <view
      wx:for="{{exampleChips}}"
      wx:key="text"
      class="example-chip"
      hover-class="btn-hover"
      bindtap="onTapExample"
      data-text="{{item.text}}"
    >{{item.label}}</view>
  </view>

  <!-- ═══ 輸入區：底部 hairline + 麥克風（錄音能力就緒時）+ 居中輸入框 + 細描邊圓鈕 ═══ -->
  <view class="input-bar">
    <view class="input-shell">
      <view
        wx:if="{{voiceReady}}"
        class="voice-btn {{recording || transcribing ? 'voice-btn-on' : ''}}"
        hover-class="btn-hover"
        bindtap="onTapVoice"
      >
        <view class="mic-icon {{recording || transcribing ? 'mic-icon-on' : ''}}"></view>
      </view>
      <input
        class="input {{recording || transcribing ? 'input-recording' : ''}}"
        value="{{inputText}}"
        disabled="{{recording || transcribing}}"
        bindinput="onInput"
        bindconfirm="onSend"
        placeholder="{{transcribing ? '識別中……' : recording ? '正在聽你說……' : '用一段自然語言描述你的需求……'}}"
        placeholder-class="input-ph"
        confirm-type="send"
      />
      <view class="send-btn {{inputText.length > 0 && !loading ? 'send-btn-active' : ''}} {{loading ? 'send-btn-disabled' : ''}}" hover-class="btn-hover" bindtap="onSend">↑</view>
    </view>
  </view>
</view>
