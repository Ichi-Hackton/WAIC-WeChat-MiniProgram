/* ============================================================
   技能中心 — 侘寂極簡（與首頁視覺系統 v4 同基調）
   米白紙感基底 + 深褐文字 + 暖金克制強調 + 1px hairline
   ============================================================ */

page {
  background: #F5F1E8;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #2B2018;
  background: #F5F1E8;
}

/* ---------- 載入佔位 / 未開放 ---------- */

.placeholder,
.closed,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  font-size: 24rpx;
  color: #9A8B72;
  letter-spacing: 2rpx;
  line-height: 2;
  text-align: center;
}

.closed-mark,
.empty-mark {
  font-size: 40rpx;
  color: #8B7355;
  margin-bottom: 8rpx;
}

.closed-title {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 32rpx;
  color: #2B2018;
  letter-spacing: 4rpx;
}

.closed-note {
  margin-top: 16rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  color: #6B5D4A;
  line-height: 1.8;
}

/* ---------- 正文 ---------- */

.body {
  flex: 1;
  height: 100%;
  padding: 24rpx 40rpx 60rpx;
  box-sizing: border-box;
}

.banner {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #D8C9AE;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #A04A3C;
  letter-spacing: 1rpx;
  line-height: 1.7;
}

/* ---------- 鍛造區 ---------- */

.section {
  margin-bottom: 48rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.section-title {
  font-family: 'Source Han Serif SC', 'Songti SC', 'STSong', 'PingFang SC', serif;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #2B2018;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A8B72;
  letter-spacing: 1rpx;
}

.req-input {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #D8C9AE;
  border-radius: 8rpx;
  background: #FBF8F1;
  font-size: 26rpx;
  color: #2B2018;
  line-height: 1.7;
}

.input-ph {
  color: #B7A98E;
}

.source-toggle {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8B7355;
  letter-spacing: 1rpx;
  padding: 8rpx 0;
}

.source-input {
  margin-top: 8rpx;
  min-height: 200rpx;
}

.connector-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #9A8B72;
  letter-spacing: 1rpx;
  line-height: 1.7;
}

.forge-btn {
  margin-top: 24rpx;
  padding: 22rpx 0;
  border: 1rpx solid #8B7355;
  border-radius: 8rpx;
  background: #8B7355;
  color: #F5F1E8;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  text-align: center;
}

.forge-btn-off {
  opacity: 0.5;
  pointer-events: none;
}

/* ---------- 記錄卡 ---------- */

.rec-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E2D8C6;
  border-radius: 8rpx;
  background: #FBF8F1;
}

.rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2B2018;
  letter-spacing: 1rpx;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-badges {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rec-mine-tag {
  font-size: 18rpx;
  color: #9A8B72;
  border: 1rpx solid #D8C9AE;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

.rec-badge {
  font-size: 18rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.badge-draft { color: #8B7355; border: 1rpx solid #C9B08A; background: #F5EEDF; }
.badge-approved { color: #5A7A4E; border: 1rpx solid #A8BF9C; background: #EEF3E9; }
.badge-blocked { color: #A04A3C; border: 1rpx solid #C99A8E; background: #F6E9E5; }
.badge-rejected { color: #A04A3C; border: 1rpx solid #C99A8E; background: #F6E9E5; }
.badge-disabled { color: #6B5D4A; border: 1rpx solid #D8C9AE; background: #EFE9DD; }

.rec-kind {
  font-size: 18rpx;
  color: #8B7355;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.rec-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4A3D2E;
  line-height: 1.7;
}

.rec-req {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-left: 2rpx solid #C9B08A;
  font-size: 22rpx;
  color: #6B5D4A;
  line-height: 1.7;
}

.rec-reason {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A04A3C;
  line-height: 1.7;
}

.rec-meta-line {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #9A8B72;
  letter-spacing: 1rpx;
}

/* ---------- 審批台操作鍵 ---------- */

.rec-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E2D8C6;
}

.act-btn {
  padding: 12rpx 32rpx;
  border: 1rpx solid #C9B08A;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6B5D4A;
  letter-spacing: 2rpx;
  background: transparent;
}

.act-primary {
  border-color: #8B7355;
  background: #8B7355;
  color: #F5F1E8;
}

/* ---------- 空態 / 腳註 ---------- */

.empty {
  justify-content: flex-start;
  padding-top: 80rpx;
}

.footnote {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #B7A98E;
  letter-spacing: 1rpx;
  line-height: 1.8;
  text-align: center;
}

.btn-hover {
  opacity: 0.7;
}
