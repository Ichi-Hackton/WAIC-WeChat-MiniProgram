/* 消息气泡组件样式 */
.bubble-row {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 0;
}
.row-right {
  justify-content: flex-end;
}
.row-left {
  justify-content: flex-start;
}

/* 智多星头像 */
.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 66, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 气泡 */
.bubble {
  max-width: 78%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.bubble-user {
  background: #FF8C42;
  color: #ffffff;
  border-top-right-radius: 6rpx;
}
.bubble-ai {
  background: #ffffff;
  color: #333333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 流式纯文本 */
.streaming-text {
  white-space: pre-wrap;
}
.cursor {
  color: #FF8C42;
  animation: blink 0.9s infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 等待圆点动画 */
.typing-dots {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFB877;
  margin-right: 10rpx;
  animation: bounce 1.2s infinite;
}
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }
@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* 操作栏 */
.bubble-actions {
  display: flex;
  justify-content: flex-start;
  margin: -4rpx 0 8rpx 84rpx;
}
.action-btn {
  font-size: 22rpx;
  color: #8C7A66;
  background: #FFF3E0;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  margin-right: 16rpx;
}
.action-btn:active {
  opacity: 0.7;
}
.action-primary {
  color: #ffffff;
  background: #FFB877;
}
