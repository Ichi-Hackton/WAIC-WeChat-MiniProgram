/* 幼教智多星 全局样式 —— 幼教暖色系主题 */
page {
  background-color: #FFF9F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.65;
}

/* 通用主按钮 */
.btn-primary {
  background-color: #FF8C42;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0 44rpx;
  line-height: 76rpx;
  text-align: center;
}
.btn-primary:active {
  opacity: 0.85;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.08);
}

/* 通用分类标签 */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #FFF3E0;
  color: #FF8C42;
  margin-right: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #b9b0a4;
  font-size: 26rpx;
}
.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
